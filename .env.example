# Public configuration template. Copy locally and fill values on your machine.
# Never commit the filled local copy.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional embedding provider. No embeddings are requested during startup.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional local infrastructure. Use the same passwords as the Compose services.
POSTGRES_DB=email_agentic
POSTGRES_USER=email_agentic
POSTGRES_PASSWORD=
POSTGRES_DSN=
# App container uses postgres:5432 instead of the host loopback address.
COMPOSE_POSTGRES_DSN=
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
